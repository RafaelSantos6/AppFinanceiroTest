# Configuração do Banco de Dados (PostgreSQL / Supabase)
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres"

# Porta do Servidor HTTP
PORT=3333

# Chave Secreta para assinatura de tokens JWT (gere com: openssl rand -hex 32)
JWT_SECRET="gere_uma_chave_aleatoria_de_pelo_menos_32_bytes"

# Origem permitida pelo CORS (ex: http://localhost:8080)
CORS_ORIGIN="*"
