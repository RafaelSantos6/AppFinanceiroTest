# Configuração do Banco de Dados SQLite (Prisma)
DATABASE_URL="file:./dev.db"

# Porta do Servidor HTTP
PORT=3333

# Chave Secreta para assinatura de tokens JWT (altere em produção)
JWT_SECRET="sua_chave_secreta_jwt_forte_aqui"

# Origem permitida pelo CORS (ex: http://localhost:8080)
CORS_ORIGIN="*"
