{
  "name": "ledger-finance-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API para Sistema de Gestão Financeira com SQLite/PostgreSQL e Prisma",
  "main": "src/server.ts",
  "type": "commonjs",
  "scripts": {
    "ensure:env": "node scripts/setup-env.js",
    "predev": "node scripts/setup-env.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "preprisma:generate": "node scripts/setup-env.js",
    "prisma:generate": "prisma generate",
    "preprisma:push": "node scripts/setup-env.js",
    "prisma:push": "prisma db push",
    "preprisma:seed": "node scripts/setup-env.js",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "setup": "npm run ensure:env && npm run prisma:generate && npm run prisma:push && npm run prisma:seed",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
